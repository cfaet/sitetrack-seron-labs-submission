{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": false,
  "semi": false,
  "trailingComma": "none",
  "printWidth": 120,
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "sortImports": false,
  "sortPackageJson": false,
  "embeddedLanguageFormatting": "off",
  "ignorePatterns": [
    "repos/**",
    "node_modules/**",
    "dist/**",
    "coverage/**",
    "secrets/**",
    ".git/**",
    ".direnv/**",
    ".agents/**",
    ".codex/**",
    ".aws/**",
    ".env",
    ".env.*",
    "**/*.enc.*",
    "**/*.sops.*",
    "**/*.pem",
    "**/*.key",
    "package-lock.json",
    "flake.lock",
    "**/*.md",
    "**/*.mdx",
    "**/*.yaml",
    "**/*.yml"
  ]
}
