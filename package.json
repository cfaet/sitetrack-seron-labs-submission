{
  "name": "sitetrack",
  "version": "0.1.0",
  "description": "Construction project and materials tracking backend",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "test": "vitest run --project unit",
    "test:watch": "vitest --watch --project unit",
    "test:integration": "vitest run --project integration",
    "lint": "effect-tsgo oxlint --type-aware src tests vitest.config.ts",
    "lint:fix": "effect-tsgo oxlint --type-aware --fix src tests vitest.config.ts",
    "fmt": "oxfmt src tests vitest.config.ts package.json tsconfig.json tsconfig.build.json .oxlintrc.json .oxfmtrc.json",
    "fmt:check": "oxfmt --check src tests vitest.config.ts package.json tsconfig.json tsconfig.build.json .oxlintrc.json .oxfmtrc.json",
    "check": "npm run fmt:check && npm run lint && npm run typecheck && npm test && npm run build",
    "db:check": "tsx src/db/cli.ts check",
    "db:test:check": "tsx src/db/cli.ts test-check",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "verify:workflows": "tsx src/review/host.ts",
    "scale:up": "tsx src/scale/host.ts up",
    "scale:down": "tsx src/scale/host.ts down",
    "seed:small": "tsx src/scale/host.ts seed small",
    "seed:large": "tsx src/scale/host.ts seed large",
    "seed:check": "tsx src/scale/host.ts check",
    "bench:smoke": "tsx src/scale/host.ts smoke",
    "bench:focus": "tsx src/scale/host.ts focus",
    "bench": "tsx src/scale/host.ts bench",
    "bench:plans": "tsx src/scale/host.ts plans",
    "bench:integrity-plan": "tsx src/scale/host.ts integrity-plan",
    "bench:status": "tsx src/scale/host.ts status",
    "bench:report": "tsx src/scale/host.ts report"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": true,
  "dependencies": {
    "@effect/platform-node": "4.1.2",
    "@effect/sql-pg": "4.1.2",
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@effect/tsgo": "0.69.0",
    "@effect/vitest": "4.1.2",
    "@types/node": "24.19.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
