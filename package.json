{
  "name": "sitetrack",
  "version": "0.1.0",
  "description": "Construction project and materials tracking backend",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "private": true,
  "dependencies": {
    "@effect/platform-node": "4.1.2",
    "@effect/sql-pg": "4.1.2",
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.2",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
