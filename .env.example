# Placeholders only. Nothing loads this file automatically.
# Supply real values through gitignored secrets/dev.enc.env and secrets/test.enc.env.
# Percent-encode reserved characters in URL passwords.
DATABASE_URL=postgresql://sitetrack:REPLACE_PRIVATELY@127.0.0.1:5432/sitetrack
DATABASE_SCHEMA=sitetrack
HOST=0.0.0.0
PORT=3000

# Required only by the API server. Supply privately; no default native signing key.
AUTH_JWT_SECRET=REPLACE_WITH_BASE64URL_ENCODING_OF_32_RANDOM_BYTES
# Local HTTP only; use true with HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COMPANY_TIME_ZONE=Asia/Muscat

# Put these in a SEPARATE test bundle; never copy DATABASE_URL as a fallback.
TEST_DATABASE_URL=postgresql://sitetrack_test:REPLACE_PRIVATELY@127.0.0.1:5432/sitetrack_test
SITETRACK_TEST_DISPOSABLE=true
